.DS_Store
**/.DS_Store

.env
.env.*
!.env.example

__pycache__/
*.py[cod]

# Presentation artifacts are published from main, not the develop branch.
docs/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-daily-intel.md

# Generated trend outputs. Keep workflow/config docs tracked, but do not
# accidentally commit daily reports, topic reports, or dated raw archives.
trend/memory-dream.md
trend/financial-agents.md
trend/forward-deployed-engineering.md
trend/reports/*.md
!trend/reports/README.md
trend/raw/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Evening review private extracts. Keep final reviews tracked, but do not
# commit raw local Codex session excerpts.
reviews/raw/

# Generated Chinese reading translations. Keep the translation contract tracked,
# but do not commit dated daily outputs by default.
translations/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
